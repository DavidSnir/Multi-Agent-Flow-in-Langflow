# PostgreSQL administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-me

# Langflow internal database
LANGFLOW_DB_NAME=langflow_internal
LANGFLOW_DB_USER=langflow_app
LANGFLOW_DB_PASSWORD=replace-me
LANGFLOW_DATABASE_URL=postgresql://langflow_app:replace-me@postgres:5432/langflow_internal

# Support database
SUPPORT_DB_NAME=support_demo
SUPPORT_DB_USER=support_reader
SUPPORT_DB_PASSWORD=replace-me
SUPPORT_DATABASE_URL=postgresql://support_reader:replace-me@postgres:5432/support_demo

# Langflow
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=replace-me
LANGFLOW_SECRET_KEY=replace-with-random-secret
LANGFLOW_CONFIG_DIR=/app/langflow

# Model
GEMINI_API_KEY=replace-me

# Gmail integration
COMPOSIO_API_KEY=replace-me
